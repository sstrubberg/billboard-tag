# Local runtime
billboard-env/
__pycache__/
*.pyc
logs/

# The cache IS tracked, uncompressed. Counterintuitive but measured: git
# zlib-compresses blobs itself and deltas between versions, so a 21 MB JSON
# costs ~3 MB once and a few hundred KB a year. Pre-gzipping it defeats both
# and made the repo ~11x larger. See README > Cache and repo size.
billboard_cache.json.gz
